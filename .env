# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=covid_events

# Producer controls
PRODUCER_OFFLINE=true
PRODUCER_INTERVAL_SECONDS=15
PRODUCER_MODE=summary              # summary | historical
PRODUCER_COUNTRY_FILTER=           # e.g. IN,US,GB

# Optional: producer tuning
PRODUCER_COMPRESSION=lz4
PRODUCER_LINGER_MS=50
PRODUCER_RETRIES=3

# disease.sh endpoints (used when PRODUCER_OFFLINE=false)
PRODUCER_SUMMARY_URL=https://disease.sh/v3/covid-19/countries
PRODUCER_HISTORICAL_URL=https://disease.sh/v3/covid-19/historical?lastdays=all

# Spark app toggles
SPARK_DEBUG_CONSOLE=false          # set true to print rows to console
SPARK_TRIGGER_SEC=20               # micro-batch interval
